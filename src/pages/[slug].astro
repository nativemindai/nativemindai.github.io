---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Guide from '../layouts/Guide.astro';

export async function getStaticPaths() {
  // Slugs that would collide with other pages.
  const RESERVED = new Set(['index', '404']);
  const guides = await getCollection('guides');
  for (const guide of guides) {
    const slug = guide.data.keyword.toLowerCase();
    if (guide.id !== slug) {
      throw new Error(`Guide "${guide.id}.md": the file name must be the keyword in lowercase (${slug}.md).`);
    }
    if (RESERVED.has(slug)) {
      throw new Error(`Guide "${guide.id}.md": the keyword ${guide.data.keyword} is reserved. Pick another.`);
    }
  }
  return guides
    .filter((guide) => !guide.data.draft)
    .map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<Guide guide={guide}>
  <Content />
</Guide>
